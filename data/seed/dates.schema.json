{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Seed Entry",
    "type": "object",
    "required": [
        "month",
        "day",
        "title",
        "quote",
        "source_url",
        "needs_secondary_source",
        "needs_specific_year"
    ],
    "properties": {
        "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
        },
        "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "quote": {
            "type": "string",
            "minLength": 1
        },
        "source_url": {
            "type": "string",
            "format": "uri"
        },
        "secondary_source_url": {
            "type": [
                "string",
                "null"
            ],
            "format": "uri"
        },
        "needs_secondary_source": {
            "type": "boolean"
        },
        "needs_specific_year": {
            "type": "boolean"
        },
        "specific_year": {
            "type": [
                "integer",
                "null"
            ]
        },
        "image_url": {
            "type": [
                "string",
                "null"
            ]
        },
        "submitted_by": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "if": {
        "properties": {
            "needs_specific_year": {
                "const": true
            }
        }
    },
    "then": {
        "required": [
            "specific_year"
        ],
        "properties": {
            "specific_year": {
                "type": "integer"
            }
        }
    },
    "else": {
        "properties": {
            "specific_year": {
                "const": null
            }
        }
    },
    "additionalProperties": false
}